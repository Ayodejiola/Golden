{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Harborline golden-service values (platform contract v1)",
  "type": "object",
  "required": ["team", "system", "tier", "dataClassification", "environment", "image", "resources"],
  "properties": {
    "team": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "system": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,40}$" },
    "component": { "type": "string" },
    "tier": { "enum": ["tier-0", "tier-1", "tier-2", "tier-3"] },
    "dataClassification": { "enum": ["public", "internal", "confidential", "restricted"] },
    "environment": { "enum": ["dev", "stg", "prod"] },
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^acrhbl[a-z0-9]+\\.azurecr\\.io/[a-z0-9-]+/[a-z0-9-]+$",
          "description": "Images must come from the Harborline registry."
        },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["IfNotPresent", "Always"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "containerPort": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "config": { "type": "object", "additionalProperties": { "type": ["string", "number", "boolean"] } },
    "workloadIdentity": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "clientId": { "type": "string" }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "clientId": { "pattern": "^[0-9a-f-]{36}$" } } }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "required": ["cpu", "memory"] },
        "limits": { "type": "object", "required": ["memory"] }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "keda": {
      "type": "object",
      "properties": {
        "minReplicas": { "type": "integer", "minimum": 0 },
        "maxReplicas": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "className": { "enum": ["nginx-internal"] },
        "host": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "const": true, "description": "Network policy cannot be disabled (exception process only)." }
      }
    }
  }
}
